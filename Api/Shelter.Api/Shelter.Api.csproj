<Project Sdk="Microsoft.NET.Sdk.Web">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <!-- Build-time OpenAPI document emission. Produces ../openapi/Shelter.Api.json on every dotnet build,
             so the frontend can regenerate paths.d.ts without a running server. -->
        <OpenApiGenerateDocuments>true</OpenApiGenerateDocuments>
        <OpenApiDocumentsDirectory>$(MSBuildThisFileDirectory)../openapi</OpenApiDocumentsDirectory>
        <UserSecretsId>d29988f4-7880-4b78-ad4b-3117c3cf4683</UserSecretsId>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.6" />
        <PackageReference Include="Swashbuckle.AspNetCore" Version="10.0.6" />
        <PackageReference Include="NetTopologySuite.IO.GeoJSON4STJ" Version="4.0.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.7">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.Extensions.ApiDescription.Server" Version="10.0.0">
            <IncludeAssets>build; runtime; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shelter.App\Shelter.App.csproj" />
      <ProjectReference Include="..\Shelter.Infrastructure\Shelter.Infrastructure.csproj" />
    </ItemGroup>

    <!--
      Re-run GenerateOpenApiDocuments AFTER Build so the emitted JSON reflects the current build's dll.
      The package's stock _GenerateOpenApiDocuments hooks BeforeTargets="Build", which runs against the
      previous build's dll and leaves the JSON one build behind.
    -->
    <Target Name="GenerateOpenApiDocumentsAfterBuild" AfterTargets="Build" Condition=" '$(OpenApiGenerateDocumentsOnBuild)' == 'true' AND ('$(TargetFramework)' == '' OR '$(TargetFrameworks)' == '') " DependsOnTargets="GenerateOpenApiDocuments" />

</Project>
