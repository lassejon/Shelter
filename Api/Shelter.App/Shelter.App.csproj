<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>App</RootNamespace>
        <!-- App is Web SDK so handlers can reference Microsoft.AspNetCore.Identity and ILogger<T>
             via the framework reference without explicit package refs, but it has no entry point
             of its own — Shelter.Api is the host. -->
        <OutputType>Library</OutputType>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\Shelter.Domain\Shelter.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.7" />
    </ItemGroup>

</Project>
